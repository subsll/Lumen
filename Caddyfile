{
	admin off
	auto_https off
}

:80 {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	# API: streamed straight through (large uploads, exports).
	handle /api/* {
		reverse_proxy api:8080 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
